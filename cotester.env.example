# CoTester FAZ 3 — job-scoped env (injected by backend at run time; placeholders for local runs)
# Do not commit real secrets.

TEST_ENV=dev

# Web login URL (non-secret)
COTESTER_WEB_BASE_URL=https://app.example.com/login
BASE_LOGIN_URL=https://app.example.com/login

# Web login credential profile (aliases UI_*)
COTESTER_WEB_USERNAME=
COTESTER_WEB_PASSWORD=
UI_USERNAME=
UI_PASSWORD=

# Legacy credential slug fallback when no runtime credentials
# UI_CREDENTIAL_PROFILE=default

# Custom variables from Environment (non-secret)
# COTESTER_VAR_MY_SETTING=value
